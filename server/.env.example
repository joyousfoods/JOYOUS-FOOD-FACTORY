# ─────────────────────────────────────────────────────────────
# Joyous Food Factory — backend environment
# Copy to `.env` and fill in. NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Public URL of the storefront. Used for CORS and for building
# return URLs after payment. Comma-separate multiple origins.
CLIENT_ORIGIN=http://localhost:5173

# ── Database ────────────────────────────────────────────────
# PostgreSQL connection string.
# Local:  postgresql://postgres:postgres@localhost:5432/joyous
# Neon:   postgresql://user:pass@ep-xxx.aws.neon.tech/joyous?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/joyous

# ── Auth ────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Razorpay ────────────────────────────────────────────────
# Dashboard → Settings → API Keys. Key ID is safe to expose to the
# browser; the SECRET and WEBHOOK SECRET must stay server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → create a webhook pointing at
# POST {your-api-url}/api/payments/webhook and subscribe to:
#   payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=

# ── WhatsApp Cloud API (Meta) ───────────────────────────────
# developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Business number that RECEIVES the new-order notification, E.164 digits, no +
WHATSAPP_BUSINESS_NUMBER=919848574748
# Any random string; must match what you type into Meta's webhook setup form
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Name of the approved Meta template used for the order alert.
# Meta only allows free-form text to a number that messaged you in the last
# 24h, so business-initiated alerts need an approved template. Leave the
# template name blank to send free-form text (works while testing).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# ── Store rules ─────────────────────────────────────────────
# Delivery is calculated server-side from these. Values in PAISE.
DELIVERY_FEE_PAISE=9000
FREE_DELIVERY_THRESHOLD_PAISE=99900
COD_ENABLED=true
COD_MAX_ORDER_PAISE=1000000

# Seed an admin account on `npm run db:seed`
SEED_ADMIN_EMAIL=admin@joyousfoodfactory.com
SEED_ADMIN_PASSWORD=
